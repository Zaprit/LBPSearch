  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Templ Templates",
      "type": "shell",
      "command": "go tool templ generate",
      "options": {
        "shell": { "executable": "powershell" },
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}