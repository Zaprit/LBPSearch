package components

import "github.com/Zaprit/LBPSearch/pkg/model"
import "strconv"
import "github.com/Zaprit/LBPSearch/pkg/utils"

templ SlotCard(slot model.Slot) {
	<div class="card">
		<div class="levelicon">
			<a href={ "/slot/" + strconv.FormatInt(int64(slot.ID), 10) }>
				<img
					src={ "/icons/" + slot.GetIcon() }
					alt="Level Icon"
					class="level-icon centerslot"
					onerror="this.onerror=null; this.src='/static/img/placeholder.png'"
				/>
			</a>
		</div>
		<div class="insidecard">
			<a class="card-title" href={ "/slot/" + strconv.FormatInt(int64(slot.ID), 10) }>{ slot.Name }</a>
			<div class="container row" style="min-width: 200px;">
				<img
					src={ "/icons/" + slot.Author.GetIcon() }
					alt="Author avatar"
					class="author-avatar"
					style="max-width: 32px; min-width: 32px; height: 32px; object-fit: cover;"
					onerror="this.onerror=null; this.src='/static/img/placeholder-avatar.png'"
				/>
				<a href="#" class="author-name">{ slot.NpHandle }</a>
			</div>
			<p class="card-text">
				{ utils.TruncateText(slot.Description, 100) }
			</p>
		</div>
		<div class="card-footer container row">
			<div class="container column">
				<i class="text-centered fas fa-heart"></i>
				<span class="card-statistic">{ slot.HeartCount }</span>
			</div>
			<div class="container column">
				<i class="text-centered fas fa-download"></i>
				<span class="card-statistic">45</span>
			</div>
			<div class="container column">
				<i class="text-centered fas fa-play"></i>
				<span class="card-statistic">{ slot.PlayCount }</span>
			</div>
		</div>
	</div>
}
